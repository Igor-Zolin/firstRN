{
  "name": "tamagotchi-back",
  "version": "1.0.0",
  "description": "Tamagotchi API backed by PostgreSQL",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test",
    "db:local:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/postgres-local.ps1 setup",
    "db:local:start": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/postgres-local.ps1 start",
    "db:local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/postgres-local.ps1 stop",
    "db:local:status": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/postgres-local.ps1 status",
    "db:local:remove": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/postgres-local.ps1 remove",
    "db:init": "node tools/init-db.js",
    "db:import-items": "node tools/import-items.js",
    "db:migrate:sqlite": "node tools/migrate-sqlite-to-postgres.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@ton/core": "^0.63.1",
    "@ton/ton": "^16.3.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jimp": "^1.6.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.16.3",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "sqlite3": "^6.0.1"
  }
}
