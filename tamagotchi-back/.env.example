PORT=3000
NODE_ENV=development
JWT_SECRET=replace_with_a_long_random_secret
ENABLE_DEV_ROUTES=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-mini-app.example
TELEGRAM_BOT_TOKEN=123456789:replace_with_botfather_token
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400

DATABASE_URL=postgresql://tamagotchi:tamagotchi@localhost:5432/tamagotchi
DATABASE_POOL_MAX=10
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

TON_NETWORK=testnet
TON_CONNECT_DOMAIN=localhost
TON_CONNECT_APP_URL=http://localhost:5173
TON_CONNECT_APP_NAME=Tamagotchi
TON_CONNECT_ICON_URL=http://localhost:5173/tonconnect-icon.png
TON_CONNECT_TERMS_URL=
TON_CONNECT_PRIVACY_URL=
TON_PROOF_TTL_SECONDS=300
TON_PROOF_MAX_AGE_SECONDS=300
